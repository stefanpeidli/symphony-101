"""
Author: Stefan Peidli
Title: Snakemake workflow for SYMPHONY experiment SYM101.
Last Updated: 11.07.2025
Run: snakemake
Create DAG: snakemake --forceall --dag | dot -Tpdf > ../results/pipeline/snake_dag.pdf
Create Rulegraph: snakemake --forceall --rulegraph | dot -Tpdf > ../results/pipeline/snake_rulegraph.pdf
Description:
    This snakemake workflow starts does the following:
    - Upstream processing
        - Download FASTQ files from BaseSpace
        - Run FastQC / MultiQC on the FASTQ files
        - Trim the FASTQ files with a custom script
        - Align the trimmed FASTQ files to the guides with HISAT2
        - Count the number of reads per guide using samtools
        - Merges the counts into a single table "SYM101_counts.csv"
    - Downstream processing
        - Runs MAGeCK
        - Runs BAGEL2
        - Runs Gscreend
    All user configuration is done in the configuration/config.yaml file.
"""

import pandas as pd
from pathlib import Path
from snakemake.utils import min_version

### CONFIGURATION ###
min_version("8")
configfile: "../configuration/config.yaml"
conda: "../environments/snake_env.yaml"

### PATHS ###
TEMPDIR = Path(config['TEMPDIR'])
DATADIR = Path(config['DATADIR'])

### SAMPLES ###
fastq_files = pd.read_csv('../resources/library/SYM101_fastqs.csv', index_col=0, names=['sample_name', 'lane_type'])
sample_names = list(fastq_files.index)
single_lane_samples = list(fastq_files[fastq_files.lane_type=='single_lane'].index)
double_lane_samples = list(fastq_files[fastq_files.lane_type=='two_lanes'].index)
guide_df = pd.read_csv('../resources/library/all_gRNA_data.csv', index_col='unique_guide_name')
cell_line_dict = config['cell_lines']
cell_lines = list(cell_line_dict.values())
ena_sample_mapping = pd.read_csv("../resources/ENA/ENA_samples_PRJEB82598.tsv", index_col=15, sep='\t')
sample_long_to_short = {x: x.split('_')[0] for x in sample_names} # long name includes _SXX sample number suffix

### Define Outputs of this Workflow ###
rule all:
    input:
        # Read processing and quantification
        ## QC
        "../results/multiqc/multiqc.html",
        "../results/trimming/trimmed_summary.csv",
        ## Counts
        TEMPDIR / 'SYM101_counts.csv',
        TEMPDIR / 'SYM101_counts_corrected.csv',  # corrected sample swap
        TEMPDIR / 'SYM101_counts_filtered.csv',  # removed "bad" guides identified with MAGeCK

        # Statistical Analysis
        ## MAGeCK test, only for TP6 (TP4 for SYM4 and SYM5)
        expand('../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck.sgrna_summary.txt', 
               line=['alllines', 'H1975', 'H1299', 'A549', 'SYM4', 'SYM5'], 
               counts=['counts', 'counts_filtered'], 
               feature=['gene', 'transcript']),
        '../results/mageck/SYM101_mageck_filtered_guides_v2.tsv',
        ## MAGeCK MLE for each time point and feature
        expand('../results/mageck/summaries/{feature}_{time_key}_SYM101_{counts}_mageck_mle.sgrna_summary.txt', 
               feature=['gene', 'transcript'], 
               time_key=['alltimes', 'TP1', 'TP2', 'TP3', 'TP4', 'TP5','TP6'], 
               counts=['counts', 'counts_filtered']),

### Read processing and quantification ###
rule gunzip_fastq:
    input:
        DATADIR / 'fastq/{sample}_L00{i}_R1_001.fastq.gz'
    output:
        TEMPDIR / 'fastq/{sample}_L00{i}_R1_001.fastq'
    resources:
        mem_mb=4000,
        disk_mb=4000,
        time='00:30:00',
    shell:
        """
        gunzip -c {input} > {output}
        """

rule fastqc:
    # Produces FastQC reports for the raw FASTQ files.
    input:
        TEMPDIR / 'fastq/{sample}_L00{i}_R1_001.fastq'
    output:
        html=TEMPDIR / "fastqc/{sample}_L00{i}.html",
        zip=TEMPDIR / "fastqc/{sample}_L00{i}_fastqc.zip" # the suffix _fastqc.zip is necessary for multiqc to find the file. If not using multiqc, you are free to choose an arbitrary filename
    params:
        extra = "--quiet"
    threads: 4
    resources:
        mem_mb = 1024
    wrapper:
        "v3.3.5/bio/fastqc"

rule multiqc:
    # Produces a MultiQC report from the FastQC reports and samtools stats.
    input:
        fastqc=expand(TEMPDIR / "fastqc/{sample}_L00{i}.html", sample=double_lane_samples, i=[1,2]),
        fastqc_single=expand(TEMPDIR / "fastqc/{sample}_L001.html", sample=single_lane_samples),
        samtools=expand(TEMPDIR / "hisat2/{sample}_L00{i}_R1_001_custom_trimmed_stats.txt", sample=double_lane_samples, i=[1,2]),
        samtools_single=expand(TEMPDIR / "hisat2/{sample}_L001_R1_001_custom_trimmed_stats.txt", sample=single_lane_samples),
    output:
        "../results/multiqc/multiqc.html",
        directory("../results/multiqc/multiqc_data"),
    params:
        extra="--data-dir",  # Optional: extra parameters for multiqc.
    log:
        "logs/multiqc.log",
    wrapper:
        "v3.3.5/bio/multiqc"

rule custom_trimming:
    # Since our primers are variable in length, we use a custom script to trim the FASTQ files.
    input:
        TEMPDIR / 'fastq/{sample}_L00{i}_R1_001.fastq'
    output:
        fastq=TEMPDIR / 'trimmed/{sample}_L00{i}_R1_001_custom_trimmed.fastq',
        qc=TEMPDIR / 'trimmed/qc/{sample}_L00{i}_R1_001_custom_trimmed_qc.csv'
    params:
        primer_seq=config['primer_seq'],
        pmin=config['primer_range']['min'],
        pmax=config['primer_range']['max'],
        guide_length=config['guide_length']
    resources:
        mem_mb=16000,
        disk_mb=16000,
        time='12:00:00',
    threads: 8
    conda: "../environments/trimming_env.yaml"
    shell:
        """
        mkdir -p {TEMPDIR}/trimmed/qc
        python scripts/variable_trimming.py -i {input} -o {output.fastq} \
            -q {output.qc} \
            -p {params.primer_seq} \
            -g {params.guide_length}  \
            -r {params.pmin},{params.pmax} \
            -t {threads}
        """

rule custom_trimming_summary:
    # Summarizes the results of the custom trimming.
    input:
        expand(TEMPDIR / 'trimmed/qc/{sample}_L00{i}_R1_001_custom_trimmed_qc.csv', sample=sample_names, i=[1,2]),
        expand(TEMPDIR / 'trimmed/qc/{sample}_L001_R1_001_custom_trimmed_qc.csv', sample=single_lane_samples)
    output:
        table="../results/trimming/trimmed_summary.csv",
        fig1="../results/trimming/trimmed_summary_scatter.pdf",
        fig2="../results/trimming/trimmed_summary_violing.pdf"
    run:
        import seaborn as sns
        import matplotlib.ticker as mtick
        import matplotlib.pyplot as pl

        path = Path(config['TEMPDIR']) /'trimmed/qc'
        qcs = {x.name.split('_R1_001')[0]: pd.read_csv(x, sep='\t') for x in path.glob('*_custom_trimmed_qc.csv')}
        df = pd.concat(qcs).droplevel(1)
        df['fraction_filtered'] = df.Filtered_reads / df.Total_reads
        df['cell_line'] = [x.split('-')[1] for x in df.index]
        df['lane'] = [x.split('_')[-1] for x in df.index]
        df['replicate'] = [x.split('-')[2] if 'pool' not in x else '0'+x[-5] for x in df.index ]
        df['time_point'] = [x.split('-')[3][:3] if 'pool' not in x else 'Pool' for x in df.index ]
        df.to_csv(output.table)

        with sns.axes_style('whitegrid'):
            fig, ax = pl.subplots()
        sns.scatterplot(data=df, y='Mean_primer_distance', hue='cell_line', x='Mean_primer_certainty', ax=ax)
        pl.xlabel('Mean weighted hamming distance to primer sequence')
        pl.ylabel('Distance to second best hit')
        pl.title('Primer Detection Metrics across FASTQ files\n(still including filtered reads)')
        pl.savefig(output.fig1, dpi=300)
        pl.close()

        with sns.axes_style('whitegrid'):
            fig, ax = pl.subplots()
        sns.violinplot(data=df, x='cell_line', hue='lane', y='fraction_filtered', ax=ax, order=['01', '02', '03', 'pool'])
        ax.yaxis.set_major_formatter(mtick.PercentFormatter(1,1))
        pl.ylabel('Percent Reads Filtered')
        pl.xlabel('Library Group')
        pl.title('Fraction of Reads Removed during Trim')
        pl.savefig(output.fig2, dpi=300)
        pl.close()

rule guide_to_fasta:
    # Converts the guide sequences to FASTA format for alignment with HISAT2.
    input:
        '../resources/library/all_gRNA_data.csv'
    output:
        '../resources/library/SYM101_guides.fa'
    run:
        from tqdm.auto import tqdm
        guide_df = pd.read_csv(input[0], index_col='unique_guide_name')
        print('Converting to FASTA!')
        with open(output[0], 'w') as OUTPUT:
            for index, row in tqdm(guide_df.iterrows()):
                OUTPUT.write(f'>{index}\n')
                OUTPUT.write(f'{row.GuideSeq}\n')
        print('Done!')

rule hisat2_guide_index:
    # Builds the HISAT2 index for the guide sequences.
    input:
        '../resources/library/SYM101_guides.fa'
    output:
        expand(TEMPDIR / 'hisat2/index.{i}.ht2', i=range(1,9))
    threads: 8
    conda: "../environments/hisat2_env.yaml"
    shell:
        """
        hisat2-build -p {threads} {input} {TEMPDIR}/hisat2/index
        """

rule hisat2_align:
    # Aligns the trimmed FASTQ files to the guides using HISAT2. (Looking back, bowtie2 would have been a better choice)
    input:
        trimmed_fastq=TEMPDIR / 'trimmed/{sample}_L00{i}_R1_001_custom_trimmed.fastq',
        index=expand(TEMPDIR / 'hisat2/index.{i}.ht2', i=range(1,9))
    output:
        sam=TEMPDIR / 'hisat2/{sample}_L00{i}_R1_001_custom_trimmed.sam'
    resources:
        time='04:00:00',
        mem_mb=32000,
        disk_mb=32000
    threads: 8
    conda: "../environments/hisat2_env.yaml"
    shell:
        """
        hisat2 \
        -x {TEMPDIR}/hisat2/index \
        -U {input.trimmed_fastq} \
        -S {output.sam} \
        -p {threads}
        """

rule samtools_stats:
    # Generates statistics from the SAM files using samtools.
    input:
        sam=TEMPDIR / 'hisat2/{sample}_L00{i}_R1_001_custom_trimmed.sam'
    output:
        stats=TEMPDIR / 'hisat2/{sample}_L00{i}_R1_001_custom_trimmed_stats.txt'
    resources:
        time='01:00:00',
        mem_mb=16000,
        disk_mb=16000
    threads: 8
    conda: "../environments/samtools_env.yaml"
    shell:
        """
        samtools stats -@ {threads} {input.sam} > {output.stats}
        """

rule count:
    # Read quantification using samtools.
    input:
        sam=TEMPDIR / 'hisat2/{sample}_L00{i}_R1_001_custom_trimmed.sam'
    output:
        counts=TEMPDIR / 'counts/{sample}_L00{i}_counts.txt'
    resources:
        time='01:00:00',
        mem_mb=16000,
        disk_mb=16000
    threads: 4
    conda: "../environments/samtools_env.yaml"
    script:
        "scripts/snake_count_reads.sh"

rule merge_counts:
    # Merges the counts from all samples into a single table.
    input:
        counts_double=expand(TEMPDIR / 'counts/{sample}_L00{i}_counts.txt', sample=double_lane_samples, i=[1,2]),
        counts_single=expand(TEMPDIR / 'counts/{sample}_L001_counts.txt', sample=single_lane_samples),
        guide_df='../resources/library/all_gRNA_data.csv'
    output:
        TEMPDIR / 'SYM101_counts.csv'
    run:
        guide_df = pd.read_csv(input.guide_df, index_col='unique_guide_name')
        counts = {Path(x).name.split('_counts')[0]: pd.read_csv(x, sep='\t', header=None, index_col=0) for x in input.counts_double + input.counts_single}
        df = pd.concat(counts, axis=1)
        df.columns = df.columns.droplevel(1)
        df.index.name = 'unique_guide_name'
        df = df.fillna(0)  # fill nans with zeros
        # collapse lanes
        df = df.T
        df['sample_name'] = [x.split('_S')[0] for x in df.index]  # remove sample number by Illumina and lane
        df = df.groupby('sample_name').sum().T
        for c in df.columns: df[c] = df[c].astype('int64')  # make integer
        df = pd.merge(guide_df, df, how='right', left_index=True, right_index=True)  # add guide info
        df.to_csv(output[0])

rule correct_sample_swap:
    # Corrects the sample swap that occurred during the experiment. (sym-01-01-TP6 and sym-01-02-TP6 were swapped across replicates 1 and 2)
    input:
        TEMPDIR / 'SYM101_counts.csv'
    output:
        TEMPDIR / 'SYM101_counts_corrected.csv'
    run:
        # Correct sample swap
        df = pd.read_csv(input[0], index_col=0)
        df = df.rename({'sym-01-01-TP6' : 'sym-01-02-TP6', 'sym-01-02-TP6' : 'sym-01-01-TP6'}, axis=1)  # revert sample swap
        df.to_csv(output[0])

### Statistical Analysis ###
rule mageck_define_controls:
    # Defines the control guides for MAGeCK analysis.
    input:
        counts=TEMPDIR / 'SYM101_{counts}.csv'
    output:
        control=TEMPDIR / 'mageck/SYM101_{counts}_control_guides.txt',
    run:
        # Define where NT control guides are located in the count matrix
        df = pd.read_csv(input.counts, index_col=0)
        with open(output.control, 'w') as file:
            file.write('\n'.join([x for x in df.index if 'control' in x.lower()]))

rule mageck_test_prepare_inputs:
    # Prepares the input files for MAGeCK test.
    # Uses TP6 or TP4 as the final time point, removes initial time points and other cell lines as needed.
    input:
        counts=TEMPDIR / 'SYM101_{counts}.csv'
    output:
        gene_counts=TEMPDIR / 'mageck/{line}/gene_SYM101_{counts}.tsv',
        transcript_counts=TEMPDIR / 'mageck/{line}/transcript_SYM101_{counts}.tsv',
        day0=TEMPDIR / 'mageck/{line}/SYM101_{counts}_day0_samples.txt',
    run:
        line = wildcards.line
        df = pd.read_csv(input.counts, index_col=0)
        # Remove initial time points
        timepoints_removal = 'TP1|TP2|TP3|TP5' if (line == 'SYM4' or line == 'SYM5') else 'TP1|TP2|TP3|TP4|TP5'  # we only have TP4 for both SYM4 and SYM5
        df = df.loc[:, ~df.columns.str.contains(timepoints_removal)].copy()  
        # Remove other lines
        if line == 'alllines':
            df = df
        else:
            # keep initial metadata columns but remove columns for other cell lines
            mask = [(cell_line_dict[int(x.split('-')[1])]==line) if 'sym' in x else True for x in df.columns]
            df = df.loc[:, mask]

        # Define the count matrix (transcripts)
        sdf = df.copy()
        sdf.index.name = 'sgRNA'
        sdf.drop(['Gene', 'ensembl_gene_id', 'transcript_biotype',
            'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
            'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1, inplace=True)
        sdf.rename(dict(Transcript_ID='gene'), axis=1, inplace=True)
        sdf.to_csv(output.transcript_counts, sep='\t')

        # Define the count matrix (genes)
        sdf = df.copy()
        sdf.index.name = 'sgRNA'
        sdf.drop(['Transcript_ID', 'ensembl_gene_id', 'transcript_biotype',
            'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
            'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1, inplace=True)
        sdf.rename(dict(Gene='gene'), axis=1, inplace=True)
        sdf.to_csv(output.gene_counts, sep='\t')
        
        # Define the control samples
        # Using plasmid pools as Day0
        day0 = ','.join([x for x in df.columns if 'pool' in x])
        with open(output.day0, 'w') as file:
            file.write(day0)

rule mageck_test:
    # Runs MAGeCK test on the prepared input files.
    input:
    # I should run this per cell line I guess and only use TP6
        counts=TEMPDIR / 'mageck/{line}/{feature}_SYM101_{counts}.tsv',
        control=TEMPDIR / 'mageck/SYM101_{counts}_control_guides.txt',
        day0=TEMPDIR / 'mageck/{line}/SYM101_{counts}_day0_samples.txt',
    output:
        '../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck.sgrna_summary.txt',  # only this file is needed for downstream analysis
        temp('../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck_summary.Rnw'),
        temp('../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck.R'),
        temp('../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck.report.Rmd'),
        temp('../results/mageck/summaries/{line}/{feature}_SYM101_{counts}_mageck.log'),
    conda: "../environments/mageck_env.yaml"
    shell:
        """
        mkdir -p $(dirname {output})
        mageck test \
        --count-table {input.counts} \
        --control-sgrna {input.control} \
        --day0-label $(cat {input.day0}) \
        --output-prefix ../results/mageck/summaries/{wildcards.line}/{wildcards.feature}_SYM101_{wildcards.counts}_mageck \
        --norm-method control \
        --pdf-report \
        --sort-criteria neg \
        --adjust-method fdr
        """

rule mageck_mle_prepare_counts:
    # Prepares the counts for MAGeCK MLE module.
    input:
        counts=TEMPDIR / 'SYM101_{counts}.csv'
    output:
        counts_prepared=TEMPDIR / 'mageck/mageck_mle_{counts}_{time}_{feature}.csv',
    run:
        # Prepare counts for MAGeCK MLE module
        df = pd.read_csv(input.counts, index_col=0)
        time_key = wildcards.time
        feature_key = wildcards.feature

        # Remove initial time points if TP6 is selected
        sdf = df.loc[:, ~df.columns.str.contains('TP1|TP2|TP3|TP4|TP5')].copy() if time_key == 'TP6' else df.copy()

        # Define the count matrix (transcripts)
        sdf.drop(['ensembl_gene_id', 'transcript_biotype',
                'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
                'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1, inplace=True)
        sdf.index.name = 'sgRNA'
        if feature_key == 'transcript':
            sdf.drop(['Gene'], axis=1, inplace=True)
            sdf.rename(dict(Transcript_ID='gene'), axis=1, inplace=True)  # mageck wants this be called "gene"
        elif feature_key == 'gene':
            sdf.drop(['Transcript_ID'], axis=1, inplace=True)
            sdf.rename(dict(Gene='gene'), axis=1, inplace=True)
        
        # Save as txt (required by mageck)
        sdf.to_csv(output.counts_prepared)

rule mageck_mle_prepare_designs:
    # Prepares the design matrix for MAGeCK MLE module.
    input:
        counts=TEMPDIR / 'SYM101_counts.csv'
    output:
        design_matrix=TEMPDIR / 'mageck/mageck_mle_designmat_{time}.txt', 
    params:
        time_model='categorical'  # 'linear' or 'categorical'
    run:
        # Prepare design matrix for MAGeCK MLE module
        df = pd.read_csv(input.counts, index_col=0)
        time_key = wildcards.time

        # Remove unused columns
        tps = [x for x in ['TP1', 'TP2', 'TP3', 'TP4', 'TP5', 'TP6'] if x != time_key]
        sdf = df.loc[:, ~df.columns.str.contains('|'.join(tps))].copy()
        sdf.drop(['Gene', 'Transcript_ID', 'ensembl_gene_id', 'transcript_biotype',
                    'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
                    'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1, inplace=True)
        
        if 'TP' in time_key:
            # We only model cell lines, no time
            design_mat = pd.DataFrame(0, index=sdf.columns, columns = ['baseline', 'H1975', 'H1299', 'A549'])
            design_mat['baseline'] = 1
            for i, line in cell_line_dict.items():
                design_mat[line] = (design_mat.index.str.split('-').str[1] == f'0{i}').astype(int)
            design_mat.index.name ='Samples'
        else:
            # We model both cell lines and time points
            if params.time_model=='linear':
                # Linear time model (TP1=1, ..., TP6=6)
                design_mat = pd.DataFrame(0, index=sdf.columns, columns = ['baseline', 'H1975', 'H1299', 'A549', 'time'])
                design_mat['baseline'] = 1
                for i, line in cell_line_dict.items():
                    design_mat[line] = (design_mat.index.str.split('-').str[1] == f'0{i}').astype(int)
                design_mat['time'] = [int(x[-1]) if 'TP' in x else 0 for x in design_mat.index]
            elif params.time_model=='categorical':
                # Treat each time point as a separate category (TP1=A, ..., TP6=F)
                design_mat = pd.DataFrame(0, index=sdf.columns[1:], columns = ['baseline', 'H1975', 'H1299', 'A549', 'TP1', 'TP2', 'TP3', 'TP4', 'TP5', 'TP6'])
                design_mat['baseline'] = 1
                for i, line in cell_line_dict.items():
                    design_mat[line] = (design_mat.index.str.split('-').str[1] == f'0{i}').astype(int)

                for x in design_mat.index:
                    if 'TP' in x:
                        key = x.split('-')[-1]
                        design_mat.loc[x, key] = 1
            else:
                raise ValueError('Invalid time model. Choose "linear" or "categorical"')
        design_mat.index.name ='Samples'
        design_mat.to_csv(output.design_matrix, sep='\t')

rule mageck_mle:
    # Runs MAGeCK MLE on the prepared input files.
    input:
        counts_prepared=TEMPDIR / 'mageck/mageck_mle_{counts}_{time_key}_{feature}.csv',
        design_matrix=TEMPDIR / 'mageck/mageck_mle_designmat_{time_key}.txt',
        control=TEMPDIR / 'mageck/SYM101_{counts}_control_guides.txt'
    output:
        guide_summary='../results/mageck/summaries/{feature}_{time_key}_SYM101_{counts}_mageck_mle.sgrna_summary.txt',
        feature_summary='../results/mageck/summaries/{feature}_{time_key}_SYM101_{counts}_mageck_mle.gene_summary.txt',
        log=temp('../results/mageck/summaries/{feature}_{time_key}_SYM101_{counts}_mageck_mle.log')
    params:
        output_prefix=lambda wildcards, output: output.feature_summary.replace('.gene_summary.txt', '')
    resources:
        time='23:00:00',
        mem_mb=64000,
        disk_mb=64000
    conda: "../environments/mageck_env.yaml"
    threads: 16
    shell:
        """
        mkdir -p $(dirname {output.feature_summary})
        mageck mle \
            --count-table {input.counts_prepared} \
            --design-matrix {input.design_matrix} \
            --output-prefix {params.output_prefix} \
            --threads {threads} \
            --norm-method control \
            --control-sgrna {input.control} \
            --adjust-method fdr
        """

rule mageck_filter_guides:
    # Takes MAGeCK results per line, aggregates and marks guides that did not have an effect in any line according to MAGeCK score
    input:
        mageck=expand('../results/mageck/summaries/{line}/gene_SYM101_counts_mageck.sgrna_summary.txt', line=cell_lines),
        counts=TEMPDIR / 'SYM101_counts.csv'
    output:
        filtering_qc_plot='../results/mageck/mageck_score_vs_LFC.pdf',
